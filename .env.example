# Copy to frontend/.env.local (Next.js reads env files from frontend/).
# XAMPP defaults: DB_USER=root, DB_PASS= (empty), DB_PORT=3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=catarman_civic
DB_USER=root
DB_PASS=

# Shared password for LGU staff at /admin (admin dashboard, report status).
# Citizens never need it. Pick your own; changing it signs everyone out.
ADMIN_PASSWORD=

# Other offices that post events, as OFFICE:password pairs, comma-separated.
# Each office can only publish/edit its own events. Keys: MHO, MENRO, MSWDO, LGU.
# Example (pick your own passwords): MHO:xxxx,MENRO:yyyy
AGENCY_PASSWORDS=
