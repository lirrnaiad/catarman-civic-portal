# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32

# The VM's DNS name. Caddy gets a free HTTPS certificate for it.
SITE_ADDRESS=mc-server-lirrnaiad.eastasia.cloudapp.azure.com

# Database passwords (the database is only reachable inside Docker).
DB_PASS=
DB_ROOT_PASS=

# Staff logins: MDRRMO, then other offices as OFFICE:password pairs.
ADMIN_PASSWORD=
AGENCY_PASSWORDS=MHO:,MENRO:,MSWDO:,LGU:

# Signs staff sessions. Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Only for a plain-HTTP test (SITE_ADDRESS=:80). Leave empty with HTTPS.
ADMIN_COOKIE_INSECURE=
